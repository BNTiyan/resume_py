# ──────────────────────────────────────────────────────────────────────────────
# QuickApply — Environment Variables
# Copy this file to .env and fill in the values you need.
# At least ONE LLM provider must be configured for generation to work.
# ──────────────────────────────────────────────────────────────────────────────

# ── Google Gemini (free tier available — recommended first choice) ────────────
GEMINI_API_KEY=

# ── OpenAI (paid) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── HuggingFace Inference API (free tier, used as fallback) ───────────────────
# Get a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
# Optional: override the default HF model
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Ollama (local, fully offline) ─────────────────────────────────────────────
# Install from https://ollama.ai then run: ollama pull llama3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── LLM behaviour ─────────────────────────────────────────────────────────────
# Force a specific provider: gemini | openai | huggingface | ollama
# LLM_PROVIDER=gemini

# Set to "false" to use the legacy 8-section resume generation (more tokens)
# RESUME_SINGLE_CALL=true

# ── Flask server ──────────────────────────────────────────────────────────────
# FLASK_PORT=5000
# FLASK_HOST=127.0.0.1
# FLASK_DEBUG=false

# ── Job discovery ─────────────────────────────────────────────────────────────
# Maximum parallel workers for job page fetching
# PARALLEL_WORKERS=15
